NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Optional. Extra hostnames the site is allowed to load images from, comma
# separated — for a CDN bought after launch. images.unsplash.com and flagcdn.com
# are already allowed; the API's own host is derived from NEXT_PUBLIC_API_URL.
# Read at build time, so adding one needs a rebuild.
NEXT_PUBLIC_IMAGE_HOSTS=

# Optional. With a Google Maps Embed API key the branch cards show Google's own
# map; without one they fall back to OpenStreetMap, which needs no key and is
# what runs by default.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
